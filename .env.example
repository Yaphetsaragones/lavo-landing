# Copy to .env and fill in. Never commit .env.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=generate-with-the-command-in-the-README
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
SITE_URL=http://127.0.0.1:8000

# Leave blank to omit the snippets entirely
GOOGLE_ANALYTICS_ID=
META_PIXEL_ID=
